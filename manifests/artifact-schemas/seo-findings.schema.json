{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oegeyilmaz9/seo-aeo-geo-ultimate/contracts/seo-findings/1.0.0",
  "title": "SEO Findings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_set_id",
    "created_at",
    "producer_skill",
    "scope",
    "evidence",
    "findings",
    "declined_claims",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "finding_set_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "producer_skill": {
      "enum": [
        "seo-audit",
        "seo-competitor-pages",
        "seo-content",
        "seo-hreflang",
        "seo-images",
        "seo-page",
        "seo-programmatic",
        "seo-research",
        "seo-schema",
        "seo-sitemap",
        "seo-technical"
      ]
    },
    "scope": {"$ref": "#/$defs/scope"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://github.com/oegeyilmaz9/seo-aeo-geo-ultimate/contracts/evidence-record/1.0.0"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "declined_claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/declinedClaim"}
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "locale": {"type": "string", "pattern": "^(not_applicable|[a-z]{2}-[A-Z]{2})$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "targets"],
      "properties": {
        "objective": {"type": "string", "minLength": 1},
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/target"}
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "target_type", "locale", "source_url"],
      "properties": {
        "target_id": {"$ref": "#/$defs/id"},
        "target_type": {
          "enum": ["site", "web_page", "template", "content_set", "media_set", "sitemap", "locale_cluster"]
        },
        "locale": {"$ref": "#/$defs/locale"},
        "source_url": {"type": ["string", "null"], "pattern": "^https://"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "target_id",
        "title",
        "observation",
        "category",
        "classification",
        "severity",
        "evidence_ids",
        "candidate_owner",
        "desired_outcome",
        "verification_method",
        "limitations"
      ],
      "properties": {
        "finding_id": {"$ref": "#/$defs/id"},
        "target_id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1},
        "category": {
          "enum": [
            "content",
            "technical",
            "structured-data",
            "international",
            "sitemap",
            "media",
            "programmatic",
            "comparison",
            "measurement",
            "accessibility",
            "policy"
          ]
        },
        "classification": {"enum": ["confirmed", "vendor-recommended", "experimental", "speculative"]},
        "severity": {"enum": ["critical", "important", "minor"]},
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "candidate_owner": {
          "enum": [
            "seo-content",
            "seo-technical",
            "seo-schema",
            "seo-hreflang",
            "seo-sitemap",
            "seo-images",
            "seo-programmatic",
            "seo-competitor-pages",
            "optimise-seo"
          ]
        },
        "desired_outcome": {"type": "string", "minLength": 1},
        "verification_method": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "declinedClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "reason"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}
