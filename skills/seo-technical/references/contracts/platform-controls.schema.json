{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oegeyilmaz9/seo-aeo-geo-ultimate/contracts/platform-controls/1.0.0",
  "title": "Platform Controls Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "created_at", "review_due_at", "features", "crawlers", "change_notifications", "protocol_capabilities", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "registry_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "review_due_at": {"type": "string", "format": "date-time"},
    "features": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
    "crawlers": {"type": "array", "items": {"$ref": "#/$defs/crawler"}},
    "change_notifications": {"type": "array", "items": {"$ref": "#/$defs/changeNotification"}},
    "protocol_capabilities": {"type": "array", "items": {"$ref": "#/$defs/protocolCapability"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "vendor", "name", "status", "surfaces", "markets", "locales", "documentation_url", "last_verified_at", "effective_at", "affected_skills", "classification", "limitations"],
      "properties": {
        "feature_id": {"$ref": "#/$defs/id"},
        "vendor": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["current", "preview", "deprecated", "removed"]},
        "surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "markets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "locales": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(global|[a-z]{2}-[A-Z]{2})$"}},
        "documentation_url": {"type": "string", "pattern": "^https://"},
        "last_verified_at": {"type": "string", "format": "date-time"},
        "effective_at": {"type": ["string", "null"], "format": "date-time"},
        "affected_skills": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}},
        "classification": {"enum": ["confirmed", "vendor-recommended", "experimental", "speculative"]},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "crawler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_id", "vendor", "user_agent", "purpose", "robots_support", "waf_verification", "published_ip_source_url", "documentation_url", "business_decision", "decision_owner", "last_verified_at", "log_evidence_ref", "log_evidence_sha256", "limitations"],
      "properties": {
        "control_id": {"$ref": "#/$defs/id"},
        "vendor": {"type": "string", "minLength": 1},
        "user_agent": {"type": "string", "minLength": 1},
        "purpose": {"enum": ["search-indexing", "ai-search", "training", "user-initiated-fetch", "other"]},
        "robots_support": {"enum": ["documented", "not-documented", "unknown"]},
        "waf_verification": {"type": "string", "minLength": 1},
        "published_ip_source_url": {"type": ["string", "null"], "pattern": "^https://"},
        "documentation_url": {"type": "string", "pattern": "^https://"},
        "business_decision": {"enum": ["allow", "block", "conditional", "undecided"]},
        "decision_owner": {"type": ["string", "null"]},
        "last_verified_at": {"type": "string", "format": "date-time"},
        "log_evidence_ref": {"type": ["string", "null"], "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "log_evidence_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "changeNotification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integration_id", "protocol", "status", "endpoint", "change_scope", "documentation_url", "last_verified_at", "receipt_ref", "receipt_sha256", "owner", "limitations"],
      "properties": {
        "integration_id": {"$ref": "#/$defs/id"},
        "protocol": {"enum": ["indexnow", "merchant-feed", "news-sitemap", "video-sitemap", "other"]},
        "status": {"enum": ["current", "preview", "deprecated", "removed", "not-configured"]},
        "endpoint": {"type": ["string", "null"], "pattern": "^https://"},
        "change_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["added", "updated", "deleted", "price", "availability", "publication", "livestream"]}},
        "documentation_url": {"type": "string", "pattern": "^https://"},
        "last_verified_at": {"type": "string", "format": "date-time"},
        "receipt_ref": {"type": ["string", "null"], "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "receipt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "owner": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "protocolCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "protocol", "vendor", "status", "discovery_url", "operations", "authentication", "fallback", "documentation_url", "last_verified_at", "owner", "limitations"],
      "properties": {
        "capability_id": {"$ref": "#/$defs/id"},
        "protocol": {"enum": ["ucp", "acp", "mcp", "a2a", "other"]},
        "vendor": {"type": "string", "minLength": 1},
        "status": {"enum": ["current", "preview", "deprecated", "removed", "not-configured"]},
        "discovery_url": {"type": ["string", "null"], "pattern": "^https://"},
        "operations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "authentication": {"type": "string", "minLength": 1},
        "fallback": {"type": "string", "minLength": 1},
        "documentation_url": {"type": "string", "pattern": "^https://"},
        "last_verified_at": {"type": "string", "format": "date-time"},
        "owner": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
