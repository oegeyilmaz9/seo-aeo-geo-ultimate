{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oegeyilmaz9/seo-aeo-geo-ultimate/contracts/evidence-record/1.0.0",
  "title": "Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_id", "claim", "classification", "source_kind", "engine", "surface", "locale", "source_title", "source_url", "source_published_or_updated_at", "accessed_at", "raw_evidence_ref", "observation_method", "limitations"],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "claim": {"type": "string", "minLength": 1},
    "classification": {"enum": ["confirmed", "vendor-recommended", "experimental", "speculative"]},
    "source_kind": {"enum": ["vendor_documentation", "standard", "direct_observation", "original_research", "secondary_context"]},
    "engine": {"type": "string", "minLength": 1},
    "surface": {"type": "string", "minLength": 1},
    "locale": {"type": "string", "pattern": "^(not_applicable|[a-z]{2}-[A-Z]{2})$"},
    "source_title": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "pattern": "^https://"},
    "source_published_or_updated_at": {"type": ["string", "null"], "format": "date-time"},
    "accessed_at": {"type": "string", "format": "date-time"},
    "raw_evidence_ref": {"type": "string", "pattern": "^raw/(?!\\.\\.(?:/|$))(?!.*(?:/)\\.\\.(?:/|$))[^\\\\]+$"},
    "observation_method": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
