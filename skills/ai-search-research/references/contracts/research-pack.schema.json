{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oegeyilmaz9/seo-aeo-geo-ultimate/contracts/research-pack/1.0.0",
  "title": "Research Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "research_id", "created_at", "scope", "locales", "engines", "entities", "queries", "evidence", "competitor_observations", "ground_truth", "gaps"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "research_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "scope": {"type": "string", "minLength": 1},
    "locales": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"}},
    "engines": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["engine", "surfaces", "locales"], "properties": {"engine": {"type": "string", "minLength": 1}, "surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "locales": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"}}}}},
    "entities": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["entity_id", "name", "entity_type", "aliases", "ambiguities"], "properties": {"entity_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}, "name": {"type": "string", "minLength": 1}, "entity_type": {"type": "string", "minLength": 1}, "aliases": {"type": "array", "items": {"type": "string"}}, "ambiguities": {"type": "array", "items": {"type": "string"}}}}},
    "queries": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["query_id", "text", "locale", "intent", "audience", "journey_stage", "target_entities", "applicability"], "properties": {"query_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}, "text": {"type": "string", "minLength": 1}, "locale": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"}, "intent": {"type": "string", "minLength": 1}, "audience": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}, "journey_stage": {"enum": ["awareness", "consideration", "decision", "trust", "support"]}, "target_entities": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "applicability": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["engine", "surface"], "properties": {"engine": {"type": "string", "minLength": 1}, "surface": {"type": "string", "minLength": 1}}}}}}},
    "evidence": {"type": "array", "items": {"$ref": "https://github.com/oegeyilmaz9/seo-aeo-geo-ultimate/contracts/evidence-record/1.0.0"}},
    "competitor_observations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["observation_id", "raw_observation_ref", "engine", "surface", "locale", "observed_at", "mentioned_entities", "cited_urls"], "properties": {"observation_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}, "raw_observation_ref": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\).+"}, "engine": {"type": "string", "minLength": 1}, "surface": {"type": "string", "minLength": 1}, "locale": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"}, "observed_at": {"type": "string", "format": "date-time"}, "mentioned_entities": {"type": "array", "items": {"type": "string"}}, "cited_urls": {"type": "array", "items": {"type": "string", "pattern": "^https://"}}}}},
    "ground_truth": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["fact_id", "accepted_value", "provenance_ref", "valid_from", "valid_until"], "properties": {"fact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}, "accepted_value": {}, "provenance_ref": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\).+"}, "valid_from": {"type": "string", "format": "date-time"}, "valid_until": {"type": ["string", "null"], "format": "date-time"}}}},
    "gaps": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["gap_id", "gap_type", "engine", "surface", "locale", "description", "limitations", "related_claim_ids"], "properties": {"gap_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}, "gap_type": {"enum": ["missing_evidence", "inaccessible_surface", "unresolved_ambiguity", "stale_input", "no_web", "no_answer", "no_citation"]}, "engine": {"type": "string", "minLength": 1}, "surface": {"type": "string", "minLength": 1}, "locale": {"type": "string", "pattern": "^(not_applicable|[a-z]{2}-[A-Z]{2})$"}, "description": {"type": "string", "minLength": 1}, "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "related_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}}, "related_observation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}}}}}
  }
}
