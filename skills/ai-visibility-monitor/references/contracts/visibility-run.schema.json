{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oegeyilmaz9/seo-aeo-geo-ultimate/contracts/visibility-run/2.0.0",
  "title": "Visibility Run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "research_id", "research_ref", "research_sha256", "created_at", "mode", "interpretation_type", "causal_claim", "corpus_ref", "corpus_sha256", "prior_run_id", "prior_run_ref", "prior_run_sha256", "referral_data_ref", "referral_data_sha256", "observations", "scores", "accuracy_checks", "drift", "limitations"],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "2.0.0"]},
    "run_id": {"$ref": "#/$defs/id"},
    "research_id": {"$ref": "#/$defs/id"},
    "research_ref": {"$ref": "#/$defs/relativePath"},
    "research_sha256": {"$ref": "#/$defs/sha"},
    "created_at": {"type": "string", "format": "date-time"},
    "mode": {"enum": ["baseline", "comparison"]},
    "interpretation_type": {"const": "observational_association"},
    "causal_claim": {"const": false},
    "corpus_ref": {"$ref": "#/$defs/relativePath"},
    "corpus_sha256": {"$ref": "#/$defs/sha"},
    "collection_profile": {"$ref": "#/$defs/collectionProfile"},
    "prior_run_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "prior_run_ref": {"type": ["string", "null"], "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "prior_run_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "referral_data_ref": {"type": ["string", "null"], "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "referral_data_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "observations": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/observationV1"}, {"$ref": "#/$defs/observationV2"}]}},
    "scores": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/scoreV1"}, {"$ref": "#/$defs/scoreV2"}]}},
    "accuracy_checks": {"type": "array", "items": {"$ref": "#/$defs/accuracy"}},
    "drift": {"type": "array", "items": {"$ref": "#/$defs/drift"}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.0.0"}}},
      "then": {
        "properties": {
          "observations": {"type": "array", "items": {"$ref": "#/$defs/observationV1"}},
          "scores": {"type": "array", "items": {"$ref": "#/$defs/scoreV1"}}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "2.0.0"}}},
      "then": {
        "required": ["collection_profile"],
        "properties": {
          "observations": {"type": "array", "items": {"$ref": "#/$defs/observationV2"}},
          "scores": {"type": "array", "items": {"$ref": "#/$defs/scoreV2"}}
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "collectionProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned_repeats", "completed_repeats", "confidence_method", "confidence_level", "fresh_session_per_repeat"],
      "properties": {
        "planned_repeats": {"type": "integer"},
        "completed_repeats": {"type": "integer"},
        "confidence_method": {"enum": ["wilson", "none"]},
        "confidence_level": {"type": ["number", "null"]},
        "fresh_session_per_repeat": {"type": "boolean"}
      }
    },
    "observationV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "query_id", "engine", "surface", "locale", "observed_at", "access_status", "raw_answer_ref", "raw_answer_sha256", "access_attempt_ref", "access_attempt_sha256", "mentioned_entities", "raw_cited_urls", "canonical_cited_urls", "disclosed_model", "collection_method"],
      "properties": {
        "observation_id": {"$ref": "#/$defs/id"},
        "query_id": {"$ref": "#/$defs/id"},
        "engine": {"type": "string", "minLength": 1},
        "surface": {"type": "string", "minLength": 1},
        "locale": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"},
        "observed_at": {"type": "string", "format": "date-time"},
        "access_status": {"enum": ["observed", "inaccessible", "blocked", "unavailable", "error"]},
        "raw_answer_ref": {"type": ["string", "null"], "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "raw_answer_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "access_attempt_ref": {"type": ["string", "null"], "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "access_attempt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "mentioned_entities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "raw_cited_urls": {"type": "array", "items": {"type": "string", "pattern": "^https://"}},
        "canonical_cited_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^https://"}},
        "disclosed_model": {"type": ["string", "null"]},
        "collection_method": {"type": "string", "minLength": 1}
      }
    },
    "userLocation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["country", "region", "city"],
      "properties": {
        "country": {"type": ["string", "null"], "pattern": "^[A-Z]{2}$"},
        "region": {"type": ["string", "null"]},
        "city": {"type": ["string", "null"]}
      }
    },
    "consultedSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "cited"],
      "properties": {
        "url": {"type": "string", "pattern": "^https://"},
        "title": {"type": ["string", "null"]},
        "cited": {"type": "boolean"}
      }
    },
    "citationClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "citation_url", "claim", "cited_text", "verdict", "review_ref", "review_sha256"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/id"},
        "citation_url": {"type": "string", "pattern": "^https://"},
        "claim": {"type": "string", "minLength": 1},
        "cited_text": {"type": "string", "minLength": 1},
        "verdict": {"enum": ["supported", "partial", "unsupported", "unverifiable"]},
        "review_ref": {"$ref": "#/$defs/relativePath"},
        "review_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "observationV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "query_id", "repeat_index", "engine", "surface", "locale", "observed_at", "access_status", "raw_answer_ref", "raw_answer_sha256", "access_attempt_ref", "access_attempt_sha256", "mentioned_entities", "raw_cited_urls", "canonical_cited_urls", "disclosed_model", "collection_method", "conversation_id", "turn_index", "user_location", "device", "authenticated", "personalization", "retrieval_mode", "executed_queries", "consulted_sources", "citation_claims"],
      "properties": {
        "observation_id": {"$ref": "#/$defs/id"},
        "query_id": {"$ref": "#/$defs/id"},
        "repeat_index": {"type": "integer"},
        "engine": {"type": "string", "minLength": 1},
        "surface": {"type": "string", "minLength": 1},
        "locale": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"},
        "observed_at": {"type": "string", "format": "date-time"},
        "access_status": {"enum": ["observed", "inaccessible", "blocked", "unavailable", "error"]},
        "raw_answer_ref": {"type": ["string", "null"], "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "raw_answer_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "access_attempt_ref": {"type": ["string", "null"], "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "access_attempt_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "mentioned_entities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "raw_cited_urls": {"type": "array", "items": {"type": "string", "pattern": "^https://"}},
        "canonical_cited_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^https://"}},
        "disclosed_model": {"type": ["string", "null"]},
        "collection_method": {"type": "string", "minLength": 1},
        "conversation_id": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
        "turn_index": {"type": ["integer", "null"]},
        "user_location": {"$ref": "#/$defs/userLocation"},
        "device": {"enum": ["desktop", "mobile", "tablet", "unspecified"]},
        "authenticated": {"type": ["boolean", "null"]},
        "personalization": {"enum": ["disabled", "possible", "active", "unknown"]},
        "retrieval_mode": {"enum": ["live-web", "cache", "no-web", "unknown"]},
        "executed_queries": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "consulted_sources": {"type": "array", "items": {"$ref": "#/$defs/consultedSource"}},
        "citation_claims": {"type": "array", "items": {"$ref": "#/$defs/citationClaim"}}
      }
    },
    "scoreCore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score_id", "metric", "definition_id", "entity_id", "source_url", "definition", "numerator", "denominator", "excluded_observation_ids", "result", "uncertainty_note"],
      "properties": {
        "score_id": {"$ref": "#/$defs/id"},
        "metric": {"enum": ["mention_rate", "citation_rate", "cited_source_share", "answer_accuracy", "referral_rate"]},
        "definition_id": {"enum": ["mention-rate-observed-v1", "citation-rate-observed-v1", "cited-source-share-distinct-v1", "answer-accuracy-declared-v1", "referral-rate-events-v1"]},
        "entity_id": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"], "pattern": "^https://"},
        "definition": {"type": "string", "minLength": 1},
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer"},
        "excluded_observation_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "result": {"type": ["number", "null"]},
        "uncertainty_note": {"type": "string", "minLength": 1}
      }
    },
    "scoreV1": {"$ref": "#/$defs/scoreCore"},
    "confidenceInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "level", "lower", "upper"],
      "properties": {
        "method": {"enum": ["wilson", "not-estimated"]},
        "level": {"type": ["number", "null"]},
        "lower": {"type": ["number", "null"]},
        "upper": {"type": ["number", "null"]}
      }
    },
    "scoreV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score_id", "metric", "definition_id", "entity_id", "source_url", "definition", "numerator", "denominator", "excluded_observation_ids", "result", "uncertainty_note", "sample_size", "repeat_count", "confidence_interval"],
      "properties": {
        "score_id": {"$ref": "#/$defs/id"},
        "metric": {"enum": ["mention_rate", "citation_rate", "cited_source_share", "answer_accuracy", "referral_rate"]},
        "definition_id": {"enum": ["mention-rate-observed-v1", "citation-rate-observed-v1", "cited-source-share-distinct-v1", "answer-accuracy-declared-v1", "referral-rate-events-v1"]},
        "entity_id": {"type": ["string", "null"]},
        "source_url": {"type": ["string", "null"], "pattern": "^https://"},
        "definition": {"type": "string", "minLength": 1},
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer"},
        "excluded_observation_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "result": {"type": ["number", "null"]},
        "uncertainty_note": {"type": "string", "minLength": 1},
        "sample_size": {"type": "integer"},
        "repeat_count": {"type": "integer"},
        "confidence_interval": {"$ref": "#/$defs/confidenceInterval"}
      }
    },
    "accuracy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "fact_id", "observation_id", "observed_claim", "verdict", "review_method", "evidence", "review_ref", "review_sha256"],
      "properties": {
        "check_id": {"$ref": "#/$defs/id"},
        "fact_id": {"$ref": "#/$defs/id"},
        "observation_id": {"$ref": "#/$defs/id"},
        "observed_claim": {"type": "string", "minLength": 1},
        "verdict": {"enum": ["correct", "incorrect", "partial", "unverifiable"]},
        "review_method": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "review_ref": {"type": ["string", "null"], "pattern": "^(?![A-Za-z]:|/|\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "review_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["drift_id", "metric", "prior_score_id", "current_score_id", "comparable_cohort", "prior_value", "current_value", "delta", "comparable", "comparability_warning"],
      "properties": {
        "drift_id": {"$ref": "#/$defs/id"},
        "metric": {"type": "string", "minLength": 1},
        "prior_score_id": {"$ref": "#/$defs/id"},
        "current_score_id": {"$ref": "#/$defs/id"},
        "comparable_cohort": {"type": "string", "minLength": 1},
        "prior_value": {"type": ["number", "null"]},
        "current_value": {"type": ["number", "null"]},
        "delta": {"type": ["number", "null"]},
        "comparable": {"type": "boolean"},
        "comparability_warning": {"type": ["string", "null"]}
      }
    }
  }
}
